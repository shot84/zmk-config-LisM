// shot84 の配列（5 列 + 親指 5 + 5way の 50 キー版から移植・2026-11-09）
//
// 位置の対応（LiSM の並び）:
//   0〜29  … 指 3 行は同じ
//   30〜41 … 親指行 = 元の親指行 L5 / R5 の外→内の順。間の小さいキー（33 / 38）がスティックの「上」
//   42〜47 … スティックの 左 / 下 / 右（L 42〜44・R 45〜47）
// 元との違い:
//   ・左スティックは押し込みなし（ピン未割り当て）＝元の 5way 中央の割り当ては無い
//   ・右はトラックボール（PAW3222）＝右スティックの位置（38・45〜47）は物理的に無い。元の右 5way の割り当てを
//     置いてあるが効かない（4waystick 版にしたとき用）
//   ・エンコーダ無し＝sensor-bindings は書かない
// トラックボールのスクロールは SCROLL レイヤ（3）で効く＝snippets/trackball-*/ の scroller の layers と揃える

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define FUNC 1
#define NUM 2
#define SCROLL 3
#define BT 4

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    behaviors {
        z_shft: zmk,behavior-hold-tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        cmd_w {
            bindings = <&kp LG(W)>;
            key-positions = <0 1>;
        };

        cmd_t {
            bindings = <&kp LG(T)>;
            key-positions = <4 3>;
        };

        cmd_opt_u {
            bindings = <&kp LA(LG(U))>;
            key-positions = <5 6>;
        };

        cmd_f {
            bindings = <&kp LG(F)>;
            key-positions = <14 13>;
        };

        cmd_shift_v {
            bindings = <&kp LG(LS(V))>;
            key-positions = <24 23>;
        };

        cmd_n {
            bindings = <&kp LG(N)>;
            key-positions = <25 26>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp Q             &kp W     &kp E                &kp R     &kp T                                          &kp Y     &kp U          &kp I          &kp O          &kp P
&kp A             &kp S     &kp D                &kp F     &kp G                                          &kp H     &kp J          &kp K          &kp L          &kp MINUS
&z_shft LSHIFT Z  &kp X     &kp C                &kp V     &kp B                                          &kp N     &kp M          &mkp MB1       &mkp MB2       &lt BT PERIOD
&kp LCTRL         &kp LALT  &mt LGUI LANGUAGE_2  &kp UP    &lt SCROLL SPACE  &lt FUNC LANGUAGE_1  &kp BSPC  &lt NUM ENTER  &kp PG_UP      &kp LG(SPACE)  &kp LS(ENTER)  &kp COMMA
                            &kp LEFT             &kp DOWN  &kp RIGHT                                      &kp HOME  &kp PG_DN      &kp END
            >;
        };

        function_layer {
            display-name = "Fn";
            bindings = <
&trans  &kp F2  &kp LC(LA(LEFT))  &kp LC(LA(RIGHT))  &kp F4                                &kp F1                &kp F10               &trans               &trans                 &trans
&trans  &trans  &trans            &trans             &kp SEMICOLON                         &kp LEFT_BRACKET      &kp RIGHT_BRACKET     &kp SQT              &kp LS(LG(DOWN))       &trans
&trans  &trans  &trans            &trans             &kp TILDE                             &kp LESS_THAN         &kp GREATER_THAN      &kp LS(LG(D))        &kp LG(LS(NUMBER_4))   &kp LS(LG(NUMBER_5))
&trans  &trans  &kp LS(NUMBER_2)  &kp UP             &kp EQUAL      &kp ENTER  &kp DELETE  &kp ENTER             &kp C_VOLUME_UP       &trans               &trans                 &trans
                &kp LEFT          &kp DOWN           &kp RIGHT                             &kp LG(LEFT_BRACKET)  &kp C_VOLUME_DOWN     &kp LG(RIGHT_BRACKET)
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
&kp TAB           &kp N7        &kp N8        &kp N9        &kp MINUS                                   &kp LC(LEFT)           &kp LC(RIGHT)  &kp LC(UP_ARROW)  &kp LC(DOWN)  &kp LC(LS(LG(Z)))
&kp NUMBER_0      &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp COLON                                   &kp LG(RIGHT_BRACKET)  &kp AT_SIGN    &kp UP_ARROW      &kp EQUAL     &trans
&mt LSHIFT SLASH  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp BACKSLASH                               &kp LG(LEFT_BRACKET)   &kp LEFT       &kp DOWN          &kp RIGHT     &trans
&kp LCTRL         &kp LEFT_ALT  &kp LGUI      &kp LC(UP)    &kp LC(LG(R))  &kp LC(LS(S))  &kp ENTER     &kp ENTER              &kp PG_UP      &trans            &trans        &trans
                                &kp LC(LEFT)  &kp LC(DOWN)  &kp LC(RIGHT)                               &kp HOME               &kp PG_DN      &kp END
            >;
        };

        scroll_layer {
            display-name = "Scr";
            bindings = <
&kp ESCAPE  &kp LG(F2)         &kp LC(LA(LEFT))  &kp LC(LA(RIGHT))     &kp PIPE                                   &kp LC(LA(D))     &kp LA(LC(E))      &kp LA(LC(F))  &kp LC(LA(T))     &kp LC(LA(G))
&kp TAB     &kp DOUBLE_QUOTES  &kp AMPERSAND     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                      &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SQT        &kp LS(LG(DOWN))  &kp LC(LA(ENTER))
&kp HASH    &kp PLUS           &kp EXCLAMATION   &kp QUESTION          &kp TILDE                                  &kp LG(A)         &kp LG(C)          &kp LG(V)      &kp LC(Q)         &kp LG(PLUS)
&kp LCTRL   &trans             &kp EQUAL         &kp UP                &trans                 &trans  &kp DELETE  &trans            &kp LG(R)          &kp LA(LG(V))  &kp LG(LS(V))     &kp LG(MINUS)
                               &kp LEFT          &kp DOWN              &kp RIGHT                                  &kp LS(LC(TAB))   &mkp MB3           &kp LC(TAB)
            >;
        };

        bt_layer {
            display-name = "BT";
            bindings = <
&bt BT_SEL 0  &trans       &trans                &kp LG(LA(MINUS))  &kp LG(LA(LS(EQUAL)))                        &bt BT_CLR_ALL  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4
&bt BT_CLR    &trans       &trans                &kp LS(F11)        &kp LA(LS(S))                                &trans          &trans        &trans          &trans        &trans
&sys_reset    &bootloader  &studio_unlock        &trans             &trans                                       &trans          &trans        &studio_unlock  &bootloader   &sys_reset
&trans        &trans       &trans                &kp UP             &trans                 &trans  &bootloader   &trans          &kp PG_UP     &trans          &trans        &trans
                           &kp LG(LA(UP_ARROW))  &kp DOWN           &kp LG(LA(DOWN))                             &kp HOME        &kp PG_DN     &kp END
            >;
        };

        // ZMK Studio で足せる予備（元の LiSM のまま）
        layer_5 {
            status = "reserved";
            display-name = "Blank";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        layer_6 {
            status = "reserved";
            display-name = "Blank";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        layer_7 {
            status = "reserved";
            display-name = "Blank";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };
    };
};
